ENV=development

# เปลี่ยนเป็นสตริงสุ่มยาวๆ ก่อนขึ้น production จริง (ห้ามใช้ค่า default นี้)
JWT_SECRET=change_this_to_a_long_random_secret_before_production
JWT_EXPIRE_MINUTES=10080
ALGORITHM=HS256

# origin ของ frontend (ใช้ตั้งค่า CORS) แก้เป็น domain จริงตอน deploy
FRONTEND_ORIGIN=http://localhost:5500

SHOP_NAME=Mister Bolo
SHOP_TAX_ID=565656
SHOP_ADDRESS=ไม่บอกอยากรู้โอนมา5000

SEED_ADMIN_EMAIL=admin@misterbolo.com
